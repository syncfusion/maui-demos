  </ItemGroup>
  <!--
    The host never mentions sample types, so the compiler emits no assembly
    references. Android Release stores the DLLs in the assembly store, where a
    directory scan cannot see them. Compile the project-reference names into
    the host and load those assemblies by name.
  -->
  <Target Name="GenerateSampleAssemblyNames" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_SampleAssemblyNameLine Include="namespace SampleBrowser.Maui.Combined%3B" />
      <_SampleAssemblyNameLine Include="internal static class SampleAssemblyNames" />
      <_SampleAssemblyNameLine Include="{" />
      <_SampleAssemblyNameLine Include="    public static readonly string[] All = new[]" />
      <_SampleAssemblyNameLine Include="    {" />
      <_SampleAssemblyNameLine Include="@(ProjectReference->'        &quot;%(Filename)&quot;,')" />
      <_SampleAssemblyNameLine Include="    }%3B" />
      <_SampleAssemblyNameLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)SampleAssemblyNames.g.cs"
      Lines="@(_SampleAssemblyNameLine)"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SampleAssemblyNames.g.cs" />
    </ItemGroup>
  </Target>
</Project>
