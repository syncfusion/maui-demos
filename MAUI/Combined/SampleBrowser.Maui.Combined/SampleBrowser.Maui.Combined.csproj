<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="signing.props" Condition="Exists('signing.props')" />
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SampleBrowser.Maui.Combined</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1803</NoWarn>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>Syncfusion MAUI</ApplicationTitle>
    <!-- iOS and Mac Catalyst use LaunchScreen.storyboard, which can follow light and dark. -->
    <EnableBlankMauiSplashScreen>false</EnableBlankMauiSplashScreen>
    <ApplicationId>net.prestonmccormick.syncfusion.maui.combined</ApplicationId>
    <ApplicationIdGuid>7C4E1A2B-9F30-4D6E-A1B8-2E5C9A0D4F17</ApplicationIdGuid>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Duplicate MauiImage names across samples (dotnet_bot and others). See design.md, Combined-build fixes. -->
    <ResizetizerErrorOnDuplicateOutputFilename>false</ResizetizerErrorOnDuplicateOutputFilename>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SampleBrowser.Maui.Base" Version="35.1.37" />
  </ItemGroup>
  <ItemGroup>
    <!-- iOS supplies its own icon appearances in Platforms/iOS/Assets.xcassets. Android's adaptive mask crops the edges, so its foreground is scaled down. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" ForegroundScale="0.70" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFBFE" BaseSize="456,456" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SyncfusionLicense.txt" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Relink so actool sees Assets.xcassets/appicon.appiconset, matching XSAppIconAssets. -->
    <ImageAsset Remove="Platforms\iOS\Assets.xcassets\**\*" />
    <ImageAsset Include="Platforms\iOS\Assets.xcassets\**\*" Exclude="**\.DS_Store">
      <Link>Assets.xcassets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </ImageAsset>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
    <ImageAsset Remove="Platforms\iOS\Assets.xcassets\appicon.appiconset\**\*" />
  </ItemGroup>
  <ItemGroup>
