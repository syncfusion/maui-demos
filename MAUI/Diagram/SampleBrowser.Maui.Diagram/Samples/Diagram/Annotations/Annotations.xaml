<?xml version="1.0" encoding="utf-8" ?>
<localCore:SampleView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="SampleBrowser.Maui.Diagram.SfDiagram.Annotations">

    <localCore:SampleView.Content>
        <Grid x:Name="grid" RowDefinitions="*">
            <!-- Diagram Control -->
            <diagram:SfDiagram x:Name="Diagram" Nodes="{Binding Nodes}" Connectors="{Binding Connectors}"
                               Grid.Row="0"
                               BackgroundColor="#FAFAFA"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               Created="OnCreated" />
        </Grid>
    </localCore:SampleView.Content>

    <localCore:SampleView.OptionView>
        <ContentView>
            <ScrollView Padding="0, 0, 5, 0">
                <StackLayout Orientation="Vertical">
                    <!-- Horizontal Alignment -->
                    <Label Text="Alignment" 
                           Margin="0,15,0,8" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                    
                    <Grid x:Name="alignmentGrid" ColumnSpacing="5" RowSpacing="5" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top row: Top alignment -->
                        <Button Grid.Row="0" Grid.Column="0" Text="TL" x:Name="topLeftBtn" Clicked="OnTopLeftClicked" />
                        <Button Grid.Row="0" Grid.Column="1" Text="Top" x:Name="topCenterBtn" Clicked="OnTopCenterClicked" />
                        <Button Grid.Row="0" Grid.Column="2" Text="TR" x:Name="topRightBtn" Clicked="OnTopRightClicked" />

                        <!-- Middle row: Center alignment -->
                        <Button Grid.Row="1" Grid.Column="0" Text="Left" x:Name="leftBtn" Clicked="OnLeftClicked" />
                        <Button Grid.Row="1" Grid.Column="1" Text="Center" x:Name="centerBtn" Clicked="OnCenterClicked" />
                        <Button Grid.Row="1" Grid.Column="2" Text="Right" x:Name="rightBtn" Clicked="OnRightClicked" />

                        <!-- Bottom row: Bottom alignment -->
                        <Button Grid.Row="2" Grid.Column="0" Text="BL" x:Name="bottomLeftBtn" Clicked="OnBottomLeftClicked" />
                        <Button Grid.Row="2" Grid.Column="1" Text="Bottom" x:Name="bottomCenterBtn" Clicked="OnBottomCenterClicked" />
                        <Button Grid.Row="2" Grid.Column="2" Text="BR" x:Name="bottomRightBtn" Clicked="OnBottomRightClicked" />
                    </Grid>

                    <!-- Appearance Section -->
                    <Label Text="Appearance" 
                           Margin="0,15,0,8" 
                           FontSize="14" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>

                    <!-- Bold Button -->
                    <Grid x:Name="boldGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="boldBtn" Text="B" Clicked="OnBoldClicked" Margin="0,0,5,0" />
                        <Button x:Name="italicBtn" Text="I" Grid.Column="1" Clicked="OnItalicClicked" Margin="5,0,0,0" />
                    </Grid>

                    <!-- Font Size -->
                    <Grid x:Name="fontSizeGrid" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Font Size" 
                               Margin="0,8,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfNumericEntry x:Name="fontSizeEntry" 
                                                FontSize="12" 
                                                Grid.Column="1"
                                                Margin="5,8,0,0" 
                                                VerticalOptions="Center"
                                                HorizontalOptions="End"
                                                Minimum="8"
                                                Maximum="32"
                                                ValueChanged="OnFontSizeChanged" />
                    </Grid>

                    <!-- Text Color -->
                    <Grid x:Name="textColorGrid" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Text Color" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="textColorComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                    <!-- Font Family -->
                    <Grid x:Name="fontFamilyGrid" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Font Family" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="fontFamilyComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                </StackLayout>
            </ScrollView>
        </ContentView>
    </localCore:SampleView.OptionView>

</localCore:SampleView>