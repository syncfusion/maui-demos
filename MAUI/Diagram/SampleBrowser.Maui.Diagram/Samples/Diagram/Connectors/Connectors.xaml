<?xml version="1.0" encoding="utf-8" ?>
<localCore:SampleView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:diagram="clr-namespace:Syncfusion.Maui.Diagram;assembly=Syncfusion.Maui.Diagram"
             xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="SampleBrowser.Maui.Diagram.SfDiagram.Connectors">

    <localCore:SampleView.Content>
        <Grid x:Name="grid" RowDefinitions="*">
            <!-- Diagram Control -->
            <diagram:SfDiagram x:Name="Diagram" Nodes="{Binding Nodes}" Connectors="{Binding ConnectorCollection}"
                               Grid.Row="0"
                               BackgroundColor="#FAFAFA"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               Created="OnCreated" />
        </Grid>
    </localCore:SampleView.Content>

    <localCore:SampleView.OptionView>
        <ContentView>
            <ScrollView Padding="0, 0, 5, 0">
                <StackLayout Orientation="Vertical">
                    <!-- Connector Type -->
                    <Grid x:Name="connectorTypeGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Connector Type" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="connectorTypeComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                    <!-- Source Decorator -->
                    <Grid x:Name="sourceDecoratorGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Source Decorator" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="sourceDecoratorComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                    <!-- Target Decorator -->
                    <Grid x:Name="targetDecoratorGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Target Decorator" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="targetDecoratorComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                    <!-- Decorator Size -->
                    <Grid x:Name="decoratorSizeGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Decorator Size" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfNumericEntry x:Name="decoratorSizeEntry" 
                                                FontSize="12" 
                                                Grid.Column="1" 
                                                Placeholder="e.g., 12"
                                                Margin="5,15,0,0" 
                                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Stroke Width -->
                    <Grid x:Name="strokeWidthGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Stroke Width" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfNumericEntry x:Name="strokeWidthEntry" 
                                                FontSize="12" 
                                                Grid.Column="1" 
                                                Placeholder="e.g., 2"
                                                Margin="5,15,0,0" 
                                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Line Color -->
                    <Grid x:Name="lineColorGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Line Color" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="lineColorComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                    <!-- Dash Style -->
                    <Grid x:Name="dashStyleGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="Dash Style" 
                               Margin="0,15,0,0" 
                               LineBreakMode="WordWrap" 
                               FontSize="14" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Start" 
                               TextColor="{AppThemeBinding Light={StaticResource TileTextColourAlt1Light}, Dark={StaticResource TileTextColourAlt1}}"/>
                        <editors:SfComboBox x:Name="dashStyleComboBox" 
                                            FontSize="12" 
                                            Grid.Column="1"
                                            Margin="5,15,0,0" 
                                            VerticalOptions="Center"
                                            HorizontalOptions="End" 
                                            IsClearButtonVisible="False" />
                    </Grid>

                </StackLayout>
            </ScrollView>
        </ContentView>
    </localCore:SampleView.OptionView>

</localCore:SampleView>