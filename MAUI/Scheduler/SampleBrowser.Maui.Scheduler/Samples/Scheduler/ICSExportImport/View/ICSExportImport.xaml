<localCore:SampleView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleBrowser.Maui.Scheduler.SfScheduler.ICSExportImport"
             xmlns:local="clr-namespace:SampleBrowser.Maui.Scheduler.SfScheduler"
             xmlns:thickness="clr-namespace:Microsoft.Maui;assembly=Microsoft.Maui"
             xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
             xmlns:schedule="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler">
    <localCore:SampleView.Content>
        <Grid>
            <Grid.Margin>
                <OnPlatform x:TypeArguments="thickness:Thickness">
                    <On Platform="MacCatalyst" Value="-4,0,-4,0"/>
                    <On Platform="UWP" Value="-4,0,-6,0"/>
                </OnPlatform>
            </Grid.Margin>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,8,12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ExportButton"
                        Grid.Column="0"
                        Text="Export to iCalendar"
                        FontSize="14"
                        HeightRequest="40"
                        CornerRadius="4"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>

                <Button x:Name="ImportButton"
                        Grid.Column="1"
                        Text="Choose iCalendar file"
                        FontSize="14"
                        HeightRequest="40"
                        CornerRadius="4"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"/>
            </Grid>

            <schedule:SfScheduler Grid.Row="1"
                                  x:Name="Scheduler"
                                  x:DataType="local:ICSExportImportViewModel"
                                  AppointmentsSource="{Binding Events}"
                                  MinimumDateTime="{Binding MinDateTime}"
                                  MaximumDateTime="{Binding MaxDateTime}"
                                  DisplayDate="{Binding DisplayDate}"
                                  ShowDatePickerButton="True"
                                  AppointmentEditorMode="Add,Edit"
                                  AllowViewNavigation="True"
                                  AllowedViews="Day,Week,WorkWeek,Month,TimelineDay,TimelineMonth,TimelineWeek,TimelineWorkWeek,Agenda"
                                  View="Week">
                <schedule:SfScheduler.BindingContext>
                    <local:ICSExportImportViewModel/>
                </schedule:SfScheduler.BindingContext>
            </schedule:SfScheduler>
        </Grid>
    </localCore:SampleView.Content>
    <localCore:SampleView.Behaviors>
        <local:ICSExportImportBehavior/>
    </localCore:SampleView.Behaviors>
</localCore:SampleView>