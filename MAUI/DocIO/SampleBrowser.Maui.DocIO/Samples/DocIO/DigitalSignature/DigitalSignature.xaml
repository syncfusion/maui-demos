<?xml version="1.0" encoding="UTF-8"?>
<localCore:SampleView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:badge="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
                      xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
                      x:Class="SampleBrowser.Maui.DocIO.DocIO.DigitalSignature">
    <localCore:SampleView.Content>
        <StackLayout Margin="10">
            <Label x:Name="description" LineBreakMode="WordWrap" Text="This sample demonstrates how to digitally sign the Word document with the PFX certificate file using .NET Word Library (DocIO)."
                 VerticalOptions="Center" Margin="0,0,5,0"/>
            <Label x:Name="label1" Text=" "></Label>
            <Label x:Name="visibleButtonDescription" LineBreakMode="WordWrap" Text="Click the &quot;Visible Signature&quot; button to digitally sign the Word document with a visible signature line."
                  VerticalOptions="Center" Margin="0,0,5,0">
            </Label>
            <Label x:Name="label2" Text=" "></Label>
            <Label x:Name="invisibleButtonDescription" LineBreakMode="WordWrap" Text="Click the &quot;Invisible Signature&quot; button to digitally sign the Word document with an invisible signature. Please note that a valid certificate is required to digitally sign the generated document."
                  VerticalOptions="Center" Margin="0,0,5,0">
            </Label>
            <Label x:Name="label3" Text=" "></Label>
            <StackLayout x:Name="stkLayout" Orientation="Horizontal" Spacing="10">
                <Button x:Name="btnVisibleSignDocument" Clicked ="VisibleButton_Click" Text ="Visible Signature" HorizontalOptions="Start"/>
                <Button x:Name="btnInvisibleSignDocument" Clicked ="InvisibleButton_Click" Text ="Invisible Signature" HorizontalOptions="Start"/>
            </StackLayout>
        </StackLayout>
    </localCore:SampleView.Content>
</localCore:SampleView>