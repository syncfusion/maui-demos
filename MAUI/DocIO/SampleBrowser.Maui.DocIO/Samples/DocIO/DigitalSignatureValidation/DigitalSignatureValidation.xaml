<?xml version="1.0" encoding="UTF-8"?>
<localCore:SampleView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:badge="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
                      xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
                      x:Class="SampleBrowser.Maui.DocIO.DocIO.DigitalSignatureValidation">
	<localCore:SampleView.Content>
		<StackLayout Margin="10">
            <Label x:Name="description" LineBreakMode="WordWrap" Text="This sample demonstrates how to validate the digital signatures in existing Word document using .NET Word Library (DocIO)."
                 VerticalOptions="Center" Margin="0,0,5,0"/>
			<Label x:Name="label1" Text=" "></Label>
            <Label x:Name="viewButtonDescription" LineBreakMode="WordWrap" Text="Click the &quot;View Template&quot; button to view the input Word document. Please note that a Word-compatible viewer is required to open and view the Word document."
                 VerticalOptions="Center" Margin="0,0,5,0">
			</Label>
			<Label x:Name="label2" Text=" "></Label>
            <Label x:Name="generateButtonDescription" LineBreakMode="WordWrap" Text="Click the &quot;Validate Signature&quot; button to validate the digital signatures in the Word document and view the validation results."
                 VerticalOptions="Center" Margin="0,0,5,0">
			</Label>
			<Label x:Name="label3" Text=" "></Label>
            <StackLayout x:Name="stkLayout" Orientation="Horizontal" Spacing="10">
				<Button x:Name="btnViewTemplate" Clicked ="ButtonView_Click" Text ="View Template" HorizontalOptions="Start"/>
                <Button x:Name="btnGenerateDocument" Clicked ="Button_Click" Text ="Validate Signature" HorizontalOptions="Start"/>
			</StackLayout>
            <Label x:Name="label4" Text=" "></Label>
            <Label x:Name="resultLabel" Text="Validation Result:" VerticalOptions="Center" Margin="0,0,5,0"></Label>
            <Editor x:Name="resultEditor" AutoSize="TextChanges" IsReadOnly="True"
                    BackgroundColor="#F5F5F5" Margin="0,0,5,0"
                    MinimumHeightRequest="120" />
		</StackLayout>
	</localCore:SampleView.Content>
</localCore:SampleView>