<?xml version="1.0" encoding="utf-8" ?>
<localCore:SampleView x:Class="SampleBrowser.Maui.TreeGrid.SfTreeGrid.Filtering"
                     xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:local="clr-namespace:SampleBrowser.Maui.TreeGrid"
                     xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
                     xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
                     xmlns:sfgrid="clr-namespace:Syncfusion.Maui.TreeGrid;assembly=Syncfusion.Maui.TreeGrid">

    <localCore:SampleView.Resources>
        <OnPlatform x:Key="margin" x:TypeArguments="Thickness">
            <On Platform="WinUI"
                Value="-12,-14,-12,-14" />
            <On Platform="MacCatalyst"
                Value="-12,-10,-12,-14" />
        </OnPlatform>

        <Style TargetType="sfgrid:TreeGridHeaderCell">
            <Setter Property="FontFamily" Value="Roboto-Medium" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding">
                <Setter.Value>
                    <OnPlatform x:TypeArguments="Thickness">
                        <On Platform="iOS,WinUI,MacCatalyst" Value="16,14" />
                        <On Platform="Android" Value="16,17" />
                    </OnPlatform>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="sfgrid:TreeGridCell">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Color x:Key="frameLightThemeColor">#F7F2FB</Color>
        <Color x:Key="frameDarkThemeColor">#25232A</Color>

        <Color x:Key="searchBarLightThemeColor">#E7E0EC</Color>
        <Color x:Key="searchBarDarkThemeColor">#49454F</Color>

        <Color x:Key="filterPopupIconLightThemeColor">#49454F</Color>
        <Color x:Key="filterPopupIconDarkThemeColor">#CAC4D0</Color>

    </localCore:SampleView.Resources>

    <localCore:SampleView.Behaviors>
        <local:FilteringBehavior/>
    </localCore:SampleView.Behaviors>
    
    <localCore:SampleView.BindingContext>
        <local:EmployeeViewModel />
    </localCore:SampleView.BindingContext>

    <localCore:SampleView.Content>
        <Grid HorizontalOptions="Fill"
              Margin="{StaticResource margin}"
              Padding="0"
              x:Name="grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border HeightRequest="55"                    
                    BackgroundColor="{AppThemeBinding Light={StaticResource frameLightThemeColor}, Dark={StaticResource frameDarkThemeColor}}"
                    HorizontalOptions="Fill"
                    Stroke="#2121210A"
                    Padding="0"
                    Grid.Row="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>
                <StackLayout Orientation="Horizontal" Padding="0,0,10,6" Margin="0,5,0,0" HorizontalOptions="End" WidthRequest="{OnPlatform WinUI='300'}" HeightRequest="{OnPlatform Android='65'}">
                    <Border Padding="{OnPlatform Android='0,6,20,5'}" WidthRequest="{OnPlatform WinUI='283',Android='530', iOS='500',MacCatalyst='300'}" BackgroundColor="{AppThemeBinding Light={StaticResource searchBarLightThemeColor}, Dark={StaticResource searchBarDarkThemeColor}}" HorizontalOptions="End" HeightRequest="{OnPlatform WinUI='42',iOS='60',MacCatalyst='40'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{OnPlatform WinUI='20',MacCatalyst='20', Android='0'}" />
                        </Border.StrokeShape>
                        <ContentView x:Name="searchContentView">
                            <Grid x:Name="SearchBarContainer" ColumnSpacing="8">
                                <!-- Column Definitions -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Platform-specific Padding -->
                                <Grid.Padding>
                                    <OnPlatform x:TypeArguments="Thickness">
                                        <On Platform="WinUI, MacCatalyst"
                                            Value="16,0,10,0" />
                                        <On Platform="Android, iOS"
                                            Value="17,0,12,0" />
                                    </OnPlatform>
                                </Grid.Padding>

                                <!-- Search Icon -->
                                <Label Grid.Column="0"
                                       Text="&#xE715;"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource filterPopupIconLightThemeColor}, Dark={StaticResource filterPopupIconDarkThemeColor}}">
                                    <Label.FontFamily>
                                        <OnPlatform x:TypeArguments="x:String">
                                            <On Platform="WinUI"
                                                Value="MauiMaterialAssets.ttf#MauiMaterialAssets" />
                                            <On Platform="Android,iOS,MacCatalyst"
                                                Value="MauiMaterialAssets" />
                                        </OnPlatform>
                                    </Label.FontFamily>
                                </Label>

                                <!-- Entry inside StackLayout -->
                                <Entry x:Name="searchEntry"
                                           Grid.Column="1"
                                           Placeholder="Filter"
                                           MinimumHeightRequest="42"
                                           VerticalOptions="Center"
                                           PlaceholderColor="{AppThemeBinding Light={StaticResource filterPopupIconLightThemeColor}, Dark={StaticResource filterPopupIconDarkThemeColor}}">

                                    <Entry.HorizontalOptions>
                                        <OnPlatform x:TypeArguments="LayoutOptions">
                                            <On Platform="Android,iOS" Value="Start" />
                                        </OnPlatform>
                                    </Entry.HorizontalOptions>

                                </Entry>
                            </Grid>
                        </ContentView>
                    </Border>
                </StackLayout>
            </Border>
            <Border Padding="0"                    
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalOptions="Fill"
                    BackgroundColor="Transparent">
                <Grid>
                    <sfgrid:SfTreeGrid x:Name="treeGrid"
                                       x:DataType="local:EmployeeViewModel"
                                       ItemsSource="{Binding EmployeeList}"
                                       ChildPropertyName="ReportsTo"
                                       Margin="0,-2,0,0"
                                       ParentPropertyName="ID"
                                       FilterLevel="Extended"
                                       SelfRelationRootValue="-1"
                                       AutoExpandMode="RootNodesExpanded"
                                       ExpanderColumn="FirstName"
                                       AutoGenerateColumnsMode="None"
                                       HeaderRowHeight="56"
                                       RowHeight="48"
                                       ColumnWidthMode="Fill">

                        <sfgrid:SfTreeGrid.Columns>
                            <sfgrid:TreeGridTextColumn MappingName="FirstName"
                                   HeaderText="First Name"
                                   ColumnWidthMode="Auto"
                                   MinimumWidth="120" 
                                   CellPadding="0,14,16,14" />

                            <sfgrid:TreeGridTextColumn MappingName="LastName"
                                   HeaderText="Last Name"
                                   ColumnWidthMode="Auto"
                                   MinimumWidth="120" />

                            <sfgrid:TreeGridNumericColumn MappingName="ID"
                                   HeaderText="Employee ID"
                                   CellTextAlignment="Center"
                                   HeaderTextAlignment="Center"
                                   ColumnWidthMode="Auto"
                                   MinimumWidth="120" />

                            <sfgrid:TreeGridTextColumn MappingName="Title"
                                   HeaderText="Title"
                                   MinimumWidth="120" />

                            <sfgrid:TreeGridTextColumn MappingName="Department"
                                   HeaderText="Department"
                                   MinimumWidth="120" />

                            <sfgrid:TreeGridNumericColumn HeaderText="Rating" 
                                       MappingName="Rating"
                                      MinimumWidth="120" />
                        </sfgrid:SfTreeGrid.Columns>
                    </sfgrid:SfTreeGrid>
                </Grid>

            </Border>
        </Grid>
    </localCore:SampleView.Content>
    <localCore:SampleView.OptionView>
        <ContentView>
            <Grid ColumnSpacing="10"
                  Padding="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{OnPlatform WinUI=*,MacCatalyst=* ,Android=2*,iOS=2*}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       FontSize="15"
                       HorizontalOptions="Start"
                       Text="Filter options"
                       VerticalOptions="Center" />

                <editors:SfComboBox  x:Name="ColumnsList"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     HorizontalOptions="Start">
                    <editors:SfComboBox.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>All Columns</x:String>
                            <x:String>First Name</x:String>
                            <x:String>Last Name</x:String>
                            <x:String>Employee ID</x:String>
                            <x:String>Department</x:String>                            
                            <x:String>Title</x:String>
                            <x:String>Rating</x:String>
                        </x:Array>
                    </editors:SfComboBox.ItemsSource>

                    <editors:SfComboBox.SelectedItem>
                        <x:String>All Columns</x:String>
                    </editors:SfComboBox.SelectedItem>
                </editors:SfComboBox>

                <editors:SfComboBox  x:Name="OptionsList"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     HorizontalOptions="Start">
                    
                    <editors:SfComboBox.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Equals</x:String>
                            <x:String>Does Not Equal</x:String>
                            <x:String>Contains</x:String>
                        </x:Array>
                    </editors:SfComboBox.ItemsSource>
                    
                </editors:SfComboBox>
            </Grid>
        </ContentView>
    </localCore:SampleView.OptionView>

</localCore:SampleView>