<?xml version="1.0" encoding="utf-8" ?>
<localCore:SampleView x:Class="SampleBrowser.Maui.DataGrid.SfDataGrid.Localization"
                      xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:local="clr-namespace:SampleBrowser.Maui.DataGrid"
                      xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
                      xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
                      xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base">

    <localCore:SampleView.BindingContext>
        <local:OrderInfoViewModel>
            <x:Arguments>
                <x:String>zh-CN</x:String>
            </x:Arguments>
        </local:OrderInfoViewModel>
    </localCore:SampleView.BindingContext>

    <localCore:SampleView.Behaviors>
        <local:LocalizationBehavior/>
    </localCore:SampleView.Behaviors>

    <localCore:SampleView.Resources>

        <OnPlatform x:Key="minimumWidth"
                    x:TypeArguments="x:Double">
            <On Platform="Android,iOS"
                Value="120"/>
        </OnPlatform>

        <OnPlatform x:Key="nameMinimumWidth"
                    x:TypeArguments="x:Double">
            <On Platform="Android,iOS"
                Value="100"/>
        </OnPlatform>

        <OnPlatform x:Key="orderIdMinimumWidth"
                    x:TypeArguments="x:Double">
            <On Platform="Android,iOS"
                Value="120"/>
        </OnPlatform>

        <OnPlatform x:Key="customerIdMinimumWidth"
                    x:TypeArguments="x:Double">
            <On Platform="Android,iOS"
                Value="110"/>
        </OnPlatform>

        <OnPlatform x:Key="margin"
                    x:TypeArguments="Thickness">
            <On Platform="WinUI,MacCatalyst"
                Value="-5"/>
        </OnPlatform>

        <Style TargetType="sfgrid:DataGridHeaderCell">
            <Setter Property="FontFamily"
                    Value="Roboto-Medium"/>
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

        <Style TargetType="sfgrid:DataGridCell">
            <Setter Property="FontSize"
                    Value="14"/>
        </Style>

    </localCore:SampleView.Resources>

    <!-- DataGrid -->
    <localCore:SampleView.Content>

        <sfgrid:SfDataGrid x:Name="dataGrid"
                           Margin="{StaticResource margin}"
                           x:DataType="local:OrderInfoViewModel"
                           ItemsSource="{Binding OrdersInfo}"
                           AutoGenerateColumnsMode="None"
                           ColumnWidthMode="Fill"
                           RowHeight="48"
                           FlowDirection="LeftToRight"
                           HorizontalScrollBarVisibility="Always"
                           VerticalScrollBarVisibility="Always">

            <sfgrid:SfDataGrid.Columns>

                <sfgrid:DataGridNumericColumn
                    MappingName="OrderID"
                    HeaderText="Order ID"
                    Format="D"
                    MinimumWidth="{StaticResource orderIdMinimumWidth}"/>

                <sfgrid:DataGridNumericColumn
                    MappingName="EmployeeID"
                    HeaderText="Customer ID"
                    Format="D"
                    MinimumWidth="{StaticResource customerIdMinimumWidth}"/>

                <sfgrid:DataGridTextColumn
                    MappingName="FirstName"
                    HeaderText="Name"
                    MinimumWidth="{StaticResource nameMinimumWidth}"/>

                <sfgrid:DataGridNumericColumn
                    x:Name="FreightColumn"
                    MappingName="Freight"
                    HeaderText="Freight"
                    Format="C"
                    MinimumWidth="{StaticResource minimumWidth}"/>

                <sfgrid:DataGridTextColumn
                    MappingName="ShipCity"
                    HeaderText="City"
                    MinimumWidth="{StaticResource minimumWidth}"/>

                <sfgrid:DataGridNumericColumn
                    x:Name="PriceColumn"
                    MappingName="Price"
                    HeaderText="Price"
                    Format="C"
                    MinimumWidth="{StaticResource minimumWidth}"/>

            </sfgrid:SfDataGrid.Columns>

        </sfgrid:SfDataGrid>

    </localCore:SampleView.Content>

    <!-- Properties panel -->
    <localCore:SampleView.OptionView>

        <ContentView>

            <Grid ColumnSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       FontSize="15"
                       Text="Locale"
                       VerticalOptions="Center"/>

                <editors:SfComboBox x:Name="comboBox"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalOptions="Center">

                    <editors:SfComboBox.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>en-US</x:String>
                            <x:String>es-ES</x:String>
                            <x:String>fr-FR</x:String>
                            <x:String>zh-CN</x:String>
                        </x:Array>
                    </editors:SfComboBox.ItemsSource>

                    <editors:SfComboBox.SelectedItem>
                        <x:String>zh-CN</x:String>
                    </editors:SfComboBox.SelectedItem>

                </editors:SfComboBox>

            </Grid>

        </ContentView>

    </localCore:SampleView.OptionView>

</localCore:SampleView>