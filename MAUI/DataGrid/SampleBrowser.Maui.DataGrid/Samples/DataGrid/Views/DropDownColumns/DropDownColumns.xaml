<?xml version="1.0" encoding="utf-8" ?>

<localCore:SampleView
   x:Class="SampleBrowser.Maui.DataGrid.SfDataGrid.DropDownColumns"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SampleBrowser.Maui.DataGrid"
    xmlns:localCore="clr-namespace:SampleBrowser.Maui.Base;assembly=SampleBrowser.Maui.Base"
    xmlns:sfgrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid">

    <localCore:SampleView.BindingContext>
        <local:EmployeeShiftViewModel />
    </localCore:SampleView.BindingContext>

    <localCore:SampleView.Resources>

        <OnPlatform x:Key="minimumWidth"
                    x:TypeArguments="x:Double">
            <On Platform="Android,iOS"
                Value="130" />
        </OnPlatform>

        <OnPlatform x:Key="margin"
                    x:TypeArguments="Thickness">
            <On Platform="WinUI"
                Value="-4" />
            <On Platform="MacCatalyst"
                Value="-4" />
        </OnPlatform>

        <Style TargetType="sfgrid:DataGridHeaderCell">
            <Setter Property="FontFamily"
                    Value="Roboto-Medium" />
            <Setter Property="FontSize"
                    Value="14" />
        </Style>

        <Style TargetType="sfgrid:DataGridCell">
            <Setter Property="FontSize"
                    Value="14" />
        </Style>

    </localCore:SampleView.Resources>

    <localCore:SampleView.Content>

        <sfgrid:SfDataGrid
            x:Name="dataGrid"
            Margin="{StaticResource margin}"
            ItemsSource="{Binding Employees}"
            AutoGenerateColumnsMode="None"
            AllowEditing="True"
            NavigationMode="Cell"
            SelectionMode="Single"
            ColumnWidthMode="{OnIdiom Phone=Auto, Desktop=Fill}"
            RowHeight="48"
            HeaderRowHeight="52">

            <sfgrid:SfDataGrid.Columns>

                <sfgrid:DataGridNumericColumn
                    MappingName="EmployeeId"
                    HeaderText="Employee ID"
                    HeaderTextAlignment="End"
                    Format="D" />

                <sfgrid:DataGridTextColumn
                    MappingName="EmployeeName"
                    HeaderText="Employee Name"
                    HeaderTextAlignment="Start"
                    MinimumWidth="{StaticResource minimumWidth}" />

                <sfgrid:DataGridComboBoxColumn
                    MappingName="Department"
                    HeaderText="Department"
                    HeaderTextAlignment="Start"
                    CanFilterSuggestions="True"
                    IsEditableMode="True"
                    ItemsSource="{Binding Departments}"
                    MinimumWidth="{StaticResource minimumWidth}" />

                <sfgrid:DataGridMultiColumnComboBoxColumn
                    MappingName="AssignedProject"
                    HeaderText="Assigned Project"
                    HeaderTextAlignment="Start"
                    ItemsSource="{Binding Projects}"                    
                    DisplayMember="ProjectName">

                    <sfgrid:DataGridMultiColumnComboBoxColumn.Columns>

                        <sfgrid:DataGridTextColumn
                            MappingName="ProjectId"
                            HeaderText="Project ID" />

                        <sfgrid:DataGridTextColumn
                            MappingName="ProjectName"
                            HeaderText="Project Name" />

                        <sfgrid:DataGridTextColumn
                            MappingName="Customer"
                            HeaderText="Customer" />

                    </sfgrid:DataGridMultiColumnComboBoxColumn.Columns>

                </sfgrid:DataGridMultiColumnComboBoxColumn>

                <sfgrid:DataGridDateColumn
                    MappingName="JoinDate"
                    HeaderText="Join Date"
                    HeaderTextAlignment="End"
                    Format="dd/MM/yyyy"
                    MinimumWidth="{StaticResource minimumWidth}" />

                <sfgrid:DataGridTimePickerColumn
                    MappingName="ShiftStartTime"
                    HeaderText="Shift Time"
                    HeaderTextAlignment="End"
                    CellTextAlignment="End"
                    Format="hh\:mm"
                    MinimumWidth="{StaticResource minimumWidth}" />

                <sfgrid:DataGridPickerColumn
                    MappingName="WorkLocation"
                    HeaderText="Location"
                    HeaderTextAlignment="Start"
                    ItemsSource="{Binding Locations}"
                    MinimumWidth="{StaticResource minimumWidth}" />

            </sfgrid:SfDataGrid.Columns>

        </sfgrid:SfDataGrid>

    </localCore:SampleView.Content>

</localCore:SampleView>