<Project>
	<ItemGroup>	
		<Compile Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\GettingStarted\View\GettingStarted.xaml.cs">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStarted.xaml.cs</Link>
			<DependentUpon>GettingStarted.xaml</DependentUpon>
		</Compile>

		<Compile Include="$(msbuildthisfiledirectory)\Samples\GridSplitter\GettingStarted\View\GettingStartedDesktop.xaml.cs">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStartedDesktop.xaml.cs</Link>
			<dependentupon>GettingStartedDesktop.xaml</dependentupon>
		</Compile>

		<Compile Include="$(msbuildthisfiledirectory)\Samples\GridSplitter\GettingStarted\View\GettingStartedMobile.xaml.cs">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStartedMobile.xaml.cs</Link>
			<dependentupon>GettingStartedMobile.xaml</dependentupon>
		</Compile>

		<Compile Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\Helper\GridSplitterBehaviour.cs">
			<Link>Samples\GridSplitter\Helper\GridSplitterBehaviour.cs</Link>
		</Compile>

		<Compile Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\Helper\SfCustomEntry.cs">
			<Link>Samples\GridSplitter\Helper\SfCustomEntry.cs</Link>
		</Compile>

		<Compile Include="$(msbuildthisfiledirectory)\Samples\GridSplitter\Model\DashBoardModel.cs">
			<Link>Samples\GridSplitter\Model\DashBoardModel.cs</Link>
		</Compile>


		<Compile Include="$(msbuildthisfiledirectory)\Samples\GridSplitter\ViewModel\DashboardViewModel.cs">
		  <Link>Samples\GridSplitter\GettingStarted\ViewModel\DashboardViewModel.cs</Link>
		</Compile>

    
	</ItemGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)\GridSplitterSamplesList.xml" >
			<Link>GridSplitterSamplesList.xml</Link>
		</EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
		<MauiXaml Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\GettingStarted\View\GettingStarted.xaml">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStarted.xaml</Link>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\GettingStarted\View\GettingStartedDesktop.xaml">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStartedDesktop.xaml</Link>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Include="$(MSBuildThisFileDirectory)\Samples\GridSplitter\GettingStarted\View\GettingStartedMobile.xaml">
			<Link>Samples\GridSplitter\GettingStarted\View\GettingStartedMobile.xaml</Link>
		</MauiXaml>
	</ItemGroup>

</Project>