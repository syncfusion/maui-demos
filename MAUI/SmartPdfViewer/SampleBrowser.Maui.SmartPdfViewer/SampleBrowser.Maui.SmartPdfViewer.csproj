<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SampleBrowser.Maui.SmartPdfViewer</RootNamespace>
    <UseMaui>true</UseMaui>
    <MAuiXamlInflator>SourceGen</MAuiXamlInflator>
    <Nullable>enable</Nullable>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisLevelSecurity>latest-recommended</AnalysisLevelSecurity>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1803;NU1510</NoWarn>
    <!-- Display name -->
    <ApplicationTitle>SampleBrowser.Maui.SmartPdfViewer</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.samplebrowser.maui.smartpdfviewer</ApplicationId>
    <ApplicationIdGuid>e1db8031-244e-4909-a6ad-280f55daacfd</ApplicationIdGuid>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.18362.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
    <Configurations>Debug;Release;Release-Xml</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineConstants>TRACE;DEBUG;</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>TRACE;RELEASE;</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-Xml|AnyCPU' ">
    <DefineConstants>TRACE;RELEASE;</DefineConstants>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="*" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4822E3" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4822E3" BaseSize="*,*" />
    <!-- Images -->
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Platforms\Android\Resources\xml\file_paths.xml" />
    <None Remove="Samples\Pdf\redaction.pdf" />
    <None Remove="Samples\Pdf\smart-form.pdf" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ControlList.xml" />
    <EmbeddedResource Include="PdfViewerSamplesList.xml" />
    <EmbeddedResource Include="Samples\Pdf\PDF_Succinctly.pdf" />
    <EmbeddedResource Include="Samples\Pdf\redaction.pdf" />
    <EmbeddedResource Include="Samples\Pdf\smart-form.pdf" />
    <EmbeddedResource Include="SyncfusionLicense.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SampleBrowser.Maui.Base" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.SmartPdfViewer" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.PdfViewer" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.SmartComponents" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Core" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.TreeView" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.AIAssistView" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Buttons" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Popup" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.TabView" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Chat" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Calendar" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Picker" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.MarkdownViewer" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Markdown" version="*" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Maui.Sliders" version="*" Version="35.1.37" />
  </ItemGroup>
  <ItemGroup>
    <MauiXaml Update="Samples\SmartPdfViewer\DocumentSummaries\View\Summarizer.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Samples\SmartPdfViewer\SmartFill\View\SmartFillView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Samples\SmartPdfViewer\SmartRedaction\View\SmartRedaction.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>
</Project>